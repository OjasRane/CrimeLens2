# Supabase Postgres connection string. Keep this server-side only.
DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Use the service-role key on the backend. The provisioning table is blocked
# for public anon/authenticated roles by Row Level Security.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_KEY=replace_with_server_side_service_role_key

# Comma-separated web origins allowed to send authenticated API requests.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Generate with: openssl rand -hex 32
ADMIN_ACCESS_TOKEN=replace_with_a_separate_random_admin_secret

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_EXPIRE_MINUTES=30

# Deprecated emergency/demo boundary only. Keep false in every production
# environment; these endpoints cannot create a Supabase session.
ENABLE_LEGACY_KINETIC_AUTH=false
