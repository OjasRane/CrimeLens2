# Supabase Postgres connection string. Keep this server-side only.
DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Use the service-role key on the backend. The provisioning table is blocked
# for public anon/authenticated roles by Row Level Security.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_KEY=replace_with_server_side_service_role_key

# Generate with: openssl rand -hex 32
ADMIN_ACCESS_TOKEN=replace_with_a_separate_random_admin_secret

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_EXPIRE_MINUTES=30
