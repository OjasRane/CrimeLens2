# Runtime mode: development, test, or production.
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# Supabase Postgres connection string. Keep this server-side only.
DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Auth issuer and public-key discovery. JWKS and issuer are derived
# from SUPABASE_URL unless explicitly overridden.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_JWKS_URL=https://project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Optional privileged key for server-only provisioning tasks. The FastAPI read
# API uses DATABASE_URL and never sends this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_side_service_role_key

# Comma-separated web origins allowed to send authenticated API requests.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

HISTORICAL_CACHE_SECONDS=300
RATE_LIMIT_PER_MINUTE=180
DOCS_ENABLED=true

# Optional connection-suggestion refinement. Without this key, the workspace
# uses the complete deterministic analyzer and all core features remain usable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=20
MAX_UPLOAD_MB=15
EVIDENCE_STORAGE_DIR=backend/.data/evidence
ALLOWED_EVIDENCE_MIME_TYPES=application/pdf,text/plain,text/csv,application/csv,application/json,image/jpeg,image/png
