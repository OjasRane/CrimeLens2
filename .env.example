# Liveblocks public key from https://liveblocks.io/dashboard
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=pk_dev_replace_me

# Public browser credentials for Supabase Auth. Never use a secret/service-role
# key in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Stable public origin used in production email-confirmation links. Add the
# matching /enroll URL to Supabase Auth > URL Configuration > Redirect URLs.
NEXT_PUBLIC_SITE_URL=https://crimelens.example.com

# Legacy Blind-Spot Detector endpoint
NEXT_PUBLIC_TIMELINE_INTEL_URL=http://localhost:8000/api/v1/intel/timeline/SUSPECT-001

# Public FastAPI origin. Browser calls include the current Supabase access token.
NEXT_PUBLIC_CRIMELENS_API_URL=http://localhost:8000
